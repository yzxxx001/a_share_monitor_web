# Web V3 使用 AKShare 公开行情，无需配置 TUSHARE_TOKEN。

# 企业微信群机器人 Webhook；dry_run=false 后才真正发送。
WECOM_BOT_WEBHOOK=

# 阿里云短信 RAM 凭据；dry_run=false 且触发 HIGH 风险提醒时使用。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 推荐填写：允许局域网访问网页时，用该口令保护网页操作入口。
MONITOR_WEB_ACCESS_TOKEN=
# 可选：固定 Flask 会话密钥；不填时每次启动随机生成。
MONITOR_WEB_SECRET_KEY=
